; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Phase Arcade"
run/main_scene="uid://32rt4ev4fjfi"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bk3mi8jga2x3l"
general/default_playback_type.web=0

[autoload]

Utils="*res://addons/jodot/autoload_me_please.gd"
Scores="*uid://c7im1hi2rhvre"

[debug]

gdscript/warnings/unused_parameter=0

[editor]

movie_writer/ogv/encoding_speed=2
movie_writer/movie_file="export/arcade-dev.avi"
movie_writer/disable_vsync=true

[file_customization]

folder_colors={
"res://Arcade Games/": "teal",
"res://Cabinets/": "orange",
"res://Game Components/": "teal",
"res://audio/": "yellow",
"res://levels/": "pink",
"res://levels/gridmap-level/": "pink",
"res://materials/": "purple",
"res://player/": "red",
"res://stuff/": "green",
"res://textures/": "purple"
}

[filesystem]

import/blender/enabled=false

[importer_defaults]

scene={
&"fbx/embedded_image_handling": 0,
&"gltf/embedded_image_handling": 0,
&"import_script/path": "uid://de4lx54fyloec"
}

